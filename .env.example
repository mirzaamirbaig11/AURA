# Flask
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# Database
# For Windows/PostgreSQL locally: postgresql://username:password@localhost:5432/aura_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura_db

# Admin
ADMIN_EMAIL=admin@aura.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=AURA Admin

# Store Settings
WHATSAPP_NUMBER=8527756728
INSTAGRAM_URL=https://instagram.com/aura_clothing
GOOGLE_MAPS_URL=https://maps.app.goo.gl/pRC9ZQcwyDGbPo5Q9

# Payment Mode - Set to true to enable Stripe online payments, false for Cash on Delivery only
ENABLE_ONLINE_PAYMENT=false

# Stripe Payment Gateway (Test Mode) - Only used when ENABLE_ONLINE_PAYMENT=true
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=inr

# Email (SMTP) - Optional for development
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@aura.com
MAIL_SUPPRESS_SEND=False

# Redis / Celery (for background tasks) - Optional for development
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5000
# Background emails via Celery (needs Redis). Keep false for local dev.
USE_CELERY=false
